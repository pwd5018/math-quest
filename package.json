{
  "name": "math-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "voice:preview": "node --experimental-strip-types scripts/export-pip-voice.mjs",
    "firebase:emulators": "firebase emulators:start --project demo-math-quest --only auth,firestore,functions",
    "firebase:rules:test": "firebase emulators:exec --project demo-math-quest --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "functions:build": "npm --prefix functions run build",
    "format": "prettier --write src functions/src tests scripts *.ts *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check src functions/src tests scripts *.ts *.json *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
