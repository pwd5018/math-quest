# Demo is fully local and requires no Firebase account.
VITE_APP_MODE=demo
# Public Firebase web-app configuration, never Admin SDK credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Use only after explicitly connecting to local emulators.
VITE_FIREBASE_EMULATORS=false
